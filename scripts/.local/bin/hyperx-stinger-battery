#!/usr/bin/env python3
"""
Bateria do HyperX Cloud Stinger Core Wireless no Linux (via /dev/hidraw).

Receptores suportados:
  - 03F0:0A93  HyperX Cloud Stinger Core (Wireless) - PS  (HP / PlayStation)
  - 0951:170B  HyperX Cloud Stinger Core Wireless + 7.1   (Kingston, original)

Protocolo portado do HyperBatteryMonitor (C#, Windows), licença MIT:
  https://github.com/davidsantanaalves/HyperBatteryMonitor
  Devices/CloudStingerCoreWirelessDevice.cs
  Copyright (c) 2026 David Santana

Uso:
  hyperx-stinger-battery            texto legível
  hyperx-stinger-battery --json     JSON (para barras e scripts)
  hyperx-stinger-battery --debug    mostra os bytes enviados e recebidos
"""

import argparse
import fcntl
import glob
import json
import os
import sys
import time

DEVICES = {
    (0x03F0, 0x0A93): "HyperX Cloud Stinger Core Wireless (PS)",
    (0x0951, 0x170B): "HyperX Cloud Stinger Core Wireless + 7.1",
}
PS_RECEIVER = (0x03F0, 0x0A93)

REPORT_ID = 0xFF

CONNECTION_COMMAND = bytes([
    0xFF, 0x07, 0x00, 0xFD, 0x04, 0x00, 0x00, 0x02,
    0x82, 0x03, 0x05, 0x29, 0x0F, 0x00, 0x00, 0x03, 0x68, 0x10, 0x00, 0x00,
])
BATTERY_COMMAND = bytes([
    0xFF, 0x07, 0x00, 0xFD, 0x04, 0x0C, 0xF1, 0x02,
    0x01, 0x04, 0xF0, 0x0C,
]) + bytes(20)

CONNECTION_INDEX = 11
CHARGE_INDEX = 9
VOLTAGE_INDEX = 11

NOT_CHARGING = 3
CHARGING = 5
FULL = 6

RESPONSE_DELAY = 0.02   # 20 ms, como no projeto original
PS_ATTEMPTS = 10        # o receptor PS às vezes devolve primeiro uma resposta antiga

CHARGING_KNOTS = [3.4000, 3.8309, 3.8707, 3.9162, 3.9299, 3.9456,
                  3.9674, 4.0000, 4.0497, 4.0900, 4.1300]
DISCHARGING_KNOTS = [3.5174, 3.6508, 3.6998, 3.7381, 3.7633, 3.7847,
                     3.8381, 3.9052, 3.9542, 4.0423, 4.1205]

DEBUG = False


def log(*args):
    if DEBUG:
        print("[debug]", *args, file=sys.stderr)


def hexs(data):
    return " ".join(f"{b:02X}" for b in data)


# ---------- ioctl do hidraw ----------

def _ioc(direction, nr, size):
    return (direction << 30) | (size << 16) | (ord("H") << 8) | nr


def hidiocsfeature(size):
    return _ioc(3, 0x06, size)


def hidiocgfeature(size):
    return _ioc(3, 0x07, size)


# ---------- descritor HID: tamanho do feature report 0xFF ----------

def feature_report_length(descriptor, report_id):
    """Soma os bits dos itens Feature do report_id; devolve bytes + 1 (o ID)."""
    i = 0
    globals_ = {"size": 0, "count": 0, "id": 0}
    stack = []
    bits = {}
    while i < len(descriptor):
        prefix = descriptor[i]
        if prefix == 0xFE:  # item longo
            if i + 1 >= len(descriptor):
                break
            i += 3 + descriptor[i + 1]
            continue
        size = (0, 1, 2, 4)[prefix & 0x03]
        kind = (prefix >> 2) & 0x03
        tag = (prefix >> 4) & 0x0F
        value = int.from_bytes(descriptor[i + 1:i + 1 + size], "little")
        i += 1 + size
        if kind == 1:  # global
            if tag == 0x7:
                globals_["size"] = value
            elif tag == 0x9:
                globals_["count"] = value
            elif tag == 0x8:
                globals_["id"] = value
            elif tag == 0xA:
                stack.append(dict(globals_))
            elif tag == 0xB and stack:
                globals_ = stack.pop()
        elif kind == 0 and tag == 0xB:  # Main: Feature
            rid = globals_["id"]
            bits[rid] = bits.get(rid, 0) + globals_["size"] * globals_["count"]
    if report_id not in bits:
        return None
    return (bits[report_id] + 7) // 8 + 1


# ---------- encontrar o receptor ----------

def find_receiver():
    found = []
    for node in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            with open(os.path.join(node, "device", "uevent")) as f:
                uevent = f.read()
        except OSError:
            continue
        hid_id = next((l.split("=", 1)[1] for l in uevent.splitlines()
                       if l.startswith("HID_ID=")), None)
        if not hid_id:
            continue
        _bus, vid, pid = hid_id.split(":")
        key = (int(vid, 16), int(pid, 16))
        if key not in DEVICES:
            continue
        try:
            with open(os.path.join(node, "device", "report_descriptor"), "rb") as f:
                descriptor = f.read()
        except OSError:
            continue
        length = feature_report_length(descriptor, REPORT_ID)
        dev = "/dev/" + os.path.basename(node)
        log(f"{dev}: {vid}:{pid}, feature 0xFF = {length} bytes")
        if length:
            found.append((dev, key, length))
    return found


# ---------- troca de feature reports ----------

def exchange(fd, command, length, accept=None, attempts=1):
    buf = bytearray(length)
    buf[:len(command)] = command
    log("TX", hexs(buf))
    fcntl.ioctl(fd, hidiocsfeature(length), buf)
    for attempt in range(attempts):
        time.sleep(RESPONSE_DELAY)
        resp = bytearray(length)
        resp[0] = REPORT_ID
        fcntl.ioctl(fd, hidiocgfeature(length), resp, True)
        log(f"RX[{attempt}]", hexs(resp))
        if accept is None or accept(resp):
            return resp
    return None


def is_ps_battery_response(r):
    return len(r) >= VOLTAGE_INDEX + 2 and r[0] == REPORT_ID and r[1] == 0x12 and r[2] == 0x05


def millivolts_to_percent(mv, charge):
    if charge == FULL:
        return 100
    v = mv / 1000.0
    knots = CHARGING_KNOTS if charge == CHARGING else DISCHARGING_KNOTS
    if v >= knots[-1]:
        return 100
    for i in range(len(knots) - 1):
        if knots[i] <= v <= knots[i + 1]:
            return i * 10 + int((v - knots[i]) / (knots[i + 1] - knots[i]) * 10)
    return 0


def query(dev, key, length):
    result = {"device": DEVICES[key], "connected": False,
              "percent": None, "charging": None, "millivolts": None}
    fd = os.open(dev, os.O_RDWR)
    try:
        conn = exchange(fd, CONNECTION_COMMAND, length)
        if conn is None or len(conn) <= CONNECTION_INDEX or conn[CONNECTION_INDEX] != 1:
            return result
        result["connected"] = True

        is_ps = key == PS_RECEIVER
        r = exchange(fd, BATTERY_COMMAND, length,
                     accept=is_ps_battery_response if is_ps else None,
                     attempts=PS_ATTEMPTS if is_ps else 1)
        if r is None:
            raise RuntimeError("o headset não respondeu ao pedido de bateria")
        charge = r[CHARGE_INDEX]
        if charge not in (NOT_CHARGING, CHARGING, FULL):
            raise RuntimeError(f"estado de carga inesperado: 0x{charge:02X}")
        mv = int.from_bytes(r[VOLTAGE_INDEX:VOLTAGE_INDEX + 2], "little", signed=True)
        result["millivolts"] = mv
        result["charging"] = charge == CHARGING
        result["percent"] = millivolts_to_percent(mv, charge)
        return result
    finally:
        os.close(fd)


def main():
    global DEBUG
    parser = argparse.ArgumentParser(description="Bateria do HyperX Cloud Stinger Core Wireless")
    parser.add_argument("--json", action="store_true", help="saída em JSON")
    parser.add_argument("--debug", action="store_true", help="mostra os bytes trocados")
    args = parser.parse_args()
    DEBUG = args.debug

    receivers = find_receiver()
    if not receivers:
        msg = "receptor não encontrado (ou sem permissão para ler /sys)"
        print(json.dumps({"error": msg}) if args.json else msg, file=sys.stdout if args.json else sys.stderr)
        return 2

    last_error = None
    for dev, key, length in receivers:
        try:
            result = query(dev, key, length)
        except PermissionError:
            last_error = f"sem permissão para abrir {dev} (veja a regra udev)"
            continue
        except (OSError, RuntimeError) as e:
            last_error = f"{dev}: {e}"
            continue

        if args.json:
            print(json.dumps(result, ensure_ascii=False))
        elif not result["connected"]:
            print(f"{result['device']}: headset desligado ou fora de alcance")
        else:
            state = " (carregando)" if result["charging"] else ""
            print(f"{result['device']}: {result['percent']}%{state} "
                  f"[{result['millivolts']} mV]")
        return 0

    print(json.dumps({"error": last_error}) if args.json else last_error,
          file=sys.stdout if args.json else sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
