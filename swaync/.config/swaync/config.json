{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 12,
  "control-center-width": 400,
  "notification-window-width": 400,
  "notification-icon-size": 48,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "widgets": [
    "menubar",
    "buttons-grid",
    "volume",
    "mpris",
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "menubar": {
      "menu#power": {
        "label": "\uf011  Energia",
        "position": "right",
        "actions": [
          { "label": "\uf023   Bloquear", "command": "swaylock -f" },
          { "label": "\uf186   Suspender", "command": "systemctl suspend" },
          { "label": "\uf08b   Sair do Niri", "command": "niri msg action quit --skip-confirmation" },
          { "label": "\uf021   Reiniciar", "command": "systemctl reboot" },
          { "label": "\uf011   Desligar", "command": "systemctl poweroff" }
        ]
      }
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "\uf1eb",
          "type": "toggle",
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[ \"$(nmcli radio wifi)\" = enabled ] && echo true || echo false'"
        },
        {
          "label": "\uf293",
          "type": "toggle",
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && bluetoothctl power on || bluetoothctl power off'",
          "update-command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'"
        }
      ]
    },
    "volume": {
      "label": "\uf028",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": true,
      "empty-list-label": "Nenhum app tocando som"
    },
    "mpris": {
      "image-size": 64,
      "image-radius": 8
    },
    "title": {
      "text": "Notificações",
      "clear-all-button": true,
      "button-text": "Limpar"
    },
    "dnd": {
      "text": "Não perturbe"
    }
  }
}
